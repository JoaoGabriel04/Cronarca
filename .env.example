# Copie para .env antes de rodar `make up`.

# Banco (PostgreSQL)
POSTGRES_USER=cronarca
POSTGRES_PASSWORD=cronarca_dev
POSTGRES_DB=cronarca

# Portas no host. Mude se colidirem com outro projeto na sua máquina.
FRONTEND_PORT=3000
# Depuração do mapa em desenvolvimento: 1 liga ?semente= e "Nova semente" em /jogo.
# Em produção é sempre desligada, valha o que valer aqui.
NEXT_PUBLIC_DEBUG_MAPA=1
BACKEND_PORT=4000
DB_PORT=5434
MAILPIT_UI_PORT=8026
MAILPIT_SMTP_PORT=1026

# Login com Google (console.cloud.google.com > APIs e serviços > Credenciais).
# URI de redirecionamento autorizado: http://localhost:3000/api/auth/google/callback
# Vazio = botão do Google aparece como indisponível.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Login com Discord (discord.com/developers/applications > OAuth2).
# Redirect: http://localhost:3000/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Avatar (cloudinary.com > Settings > API Keys). Vazio = upload de avatar desligado.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
